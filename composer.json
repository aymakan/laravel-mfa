{
    "name": "aymakan/laravel-mfa",
    "description": "API-only Multi-Factor Authentication enforcement for Laravel (TOTP, middleware-driven)",
    "keywords": ["laravel", "mfa", "totp", "middleware", "authentication"],
    "homepage": "https://github.com/aymakan/laravel-mfa",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/auth": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/session": "^13.0",
        "pragmarx/google2fa": "^9.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Aymakan\\Mfa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aymakan\\Mfa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aymakan\\Mfa\\MfaServiceProvider"
            ],
            "aliases": {
                "Mfa": "Aymakan\\Mfa\\Facades\\Mfa"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
